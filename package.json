{
  "name": "@laurowd/adao",
  "version": "0.1.1",
  "description": "Local-first CLI for scanning projects and maintaining reliable AGENTS.md context.",
  "license": "MIT",
  "keywords": [
    "agents.md",
    "ai-agents",
    "cli",
    "developer-tools",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Laurowd/Adao.git"
  },
  "homepage": "https://github.com/Laurowd/Adao#readme",
  "bugs": {
    "url": "https://github.com/Laurowd/Adao/issues"
  },
  "type": "module",
  "files": [
    "dist/",
    "README.md",
    "README.pt-BR.md"
  ],
  "bin": {
    "adao": "dist/cli.js"
  },
  "scripts": {
    "dev": "node --import tsx src/cli.ts",
    "clean": "node scripts/clean.mjs",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "npm run build",
    "test:package": "node scripts/package-smoke.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
